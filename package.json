{
  "name": "jobpilot",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.9.3",
  "description": "JobPilot - AI-powered job application assistant",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npx turbo run dev",
    "build": "npx turbo run build --filter=!extension",
    "build:api": "npx turbo run build --filter=api...",
    "build:web": "npx turbo run build --filter=web...",
    "start": "npx turbo run start",
    "test": "npx turbo run test",
    "lint": "npx turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "prettier": "^3.2.5"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "kimi-cli": "^0.0.2",
    "prisma": "^5.10.0",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  }
}